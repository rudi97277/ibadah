      "lines": [
        "B'rikanlah ya Tuhan, Roti hidup",
        "Kepadaku s'karang dengan cukup",
        "Jiwaku yang lapar, kenyangkanlah",
        "Segarkanlah aku, ya Roh Allah"
      ],
      "text": "B'rikanlah ya Tuhan, Roti hidup\nKepadaku s'karang dengan cukup\nJiwaku yang lapar, kenyangkanlah\nSegarkanlah aku, ya Roh Allah"
    },
    {
      "label": "2/3",
      "type": "verse",
      "lines": [
        "Sabda yang kut'rima s'karang Tuhan",
        "Kuyakin memberi kes'lamatan",
        "Lepaskan jiwaku dari dosa",
        "Kujadi milik-Mu selamanya"
      ],
      "text": "Sabda yang kut'rima s'karang Tuhan\nKuyakin memberi kes'lamatan\nLepaskan jiwaku dari dosa\nKujadi milik-Mu selamanya"
