      "lines": [
        "Semua yang bernafas",
        "mari puji Tuhan",
        "Khalik yang t'lah bangkit",
        "dengan kem'nangan",
        "Yang ciptakan kami,",
        "Pelindung setiawan",
        "Yang memimpin kami",
        "kekal abadi",
        "Panji-Nya kibarkan,",
