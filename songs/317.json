      "label": "1/3",
      "type": "verse",
      "lines": [
        "Aku pengembara",
        "Kar'na dosa",
        "Menumpang di dunia",
        "Hidup fana",
        "Di sini sengsara",
        "Penuh dengan duka",
        "Surga yang kunanti",
        "Neg'ri suci"
      ],
      "text": "Aku pengembara\nKar'na dosa\nMenumpang di dunia\nHidup fana\nDi sini sengsara\nPenuh dengan duka\nSurga yang kunanti\nNeg'ri suci"
    },
    {
      "label": "2/3",
      "type": "verse",
      "lines": [
        "Sini sunyi senyap",
        "Aku Ikhlas",
        "Dari jalan gelap",
        "Lari lekas",
        "Aku rindu neg'ri",
        "Di tempat yang tinggi",
        "Ke sana ku pergi",
        "Neg'ri suci"
      ],
      "text": "Sini sunyi senyap\nAku Ikhlas\nDari jalan gelap\nLari lekas\nAku rindu neg'ri\nDi tempat yang tinggi\nKe sana ku pergi\nNeg'ri suci"
    },
    {
      "label": "3/3",
      "type": "verse",
      "lines": [
        "Aku sujud sembah",
        "Pada Allah",
        "B'ri hormat dan puja",
        "Kepada-Nya",
        "Kota penuh damai",
        "Sentosa dan permai",
        "Bertemu kekasih",
        "Neg'ri suci"
      ],
      "text": "Aku sujud sembah\nPada Allah\nB'ri hormat dan puja\nKepada-Nya\nKota penuh damai\nSentosa dan permai\nBertemu kekasih\nNeg'ri suci"
    }
