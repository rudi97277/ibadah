      "lines": [
        "Lebar s'perti lautan,",
        "Tinggi atas awan",
        "Dalam s'perti dasar laut",
        "Kasihnya Tuhan",
        "Meski aku hina",
        "Ia tetap menjaga",
        "Kar'na kasih-Nya mengikut aku",
        "Di mana-mana"
      ],
