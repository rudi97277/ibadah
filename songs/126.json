      "lines": [
        "Kepala-Mu yang luka",
        "Terkulai dan perih",
        "Disiksa dan dihina",
        "Bermahkota duri",
        "Sungguh mulia dan suci",
        "Tampak di wajah-Mu",
        "Walau dunia membenci",
        "Kau tetap milikku"
      ],
      "text": "Kepala-Mu yang luka\nTerkulai dan perih\nDisiksa dan dihina\nBermahkota duri\nSungguh mulia dan suci\nTampak di wajah-Mu\nWalau dunia membenci\nKau tetap milikku"
    },
    {
      "label": "2/3",
      "type": "verse",
      "lines": [
        "Tuhan t'lah menderita",
        "Kar'na dosa kita",
        "Aku yang mendurhaka",
        "Engkau yang disiksa",
        "Kau t'lah gantikan aku",
        "Ya Jurus'lamatku",
        "Kasihanilah aku",
        "Dengan anug'rah-Mu"
      ],
      "text": "Tuhan t'lah menderita\nKar'na dosa kita\nAku yang mendurhaka\nEngkau yang disiksa\nKau t'lah gantikan aku\nYa Jurus'lamatku\nKasihanilah aku\nDengan anug'rah-Mu"
    },
    {
      "label": "3/3",
      "type": "verse",
      "lines": [
        "Tiada cukup ungkapan",
        "Syukur kepada-Mu",
        "Kau menanggung siksaan",
        "Dan mati bagiku",
        "Tuhan jadikan aku",
        "S'lamanya milik-Mu",
        "Jangan biarkan aku",
        "Abaikan kasih-Mu"
      ],
      "text": "Tiada cukup ungkapan\nSyukur kepada-Mu\nKau menanggung siksaan\nDan mati bagiku\nTuhan jadikan aku\nS'lamanya milik-Mu\nJangan biarkan aku\nAbaikan kasih-Mu"
