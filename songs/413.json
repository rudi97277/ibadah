      "lines": [
        "Yesus yang penuh kasih,",
        "Aku datang pada-Mu",
        "Saat badai menerpa",
        "Dan ombak pun memalu",
        "Ya Tuhanku, lindungkan",
        "Sampai topan pun lalu",
        "Pimpin ke pelabuhan,",
